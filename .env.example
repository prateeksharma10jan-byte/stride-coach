# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=        # python -c "import secrets; print(secrets.token_hex(16))"
# --- Strava ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=            # any random string
STRAVA_SUBSCRIPTION_ID=         # printed by scripts/setup_webhooks.py; enables event origin check
# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_DAILY_CALL_CAP=40           # per user per day
# --- App ---
APP_URL=https://your-app.example.com
APP_SECRET=                     # python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=                 # python -c "from app.crypto import TokenCipher; print(TokenCipher.generate_key())"
MAX_USERS=20
MAX_HR=190
REST_HR=55
DB_PATH=/data/stride.db
# --- Ops (optional) ---
METRICS_TOKEN=                  # enables GET /metrics with 'Authorization: Bearer <token>'
SENTRY_DSN=
RUN_WORKER=1                    # 0 if you run scripts/run_worker.py separately
LOG_JSON=1
